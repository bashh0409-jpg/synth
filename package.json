{
  "name": "arcture",
  "version": "0.1.1",
  "private": true,
  "description": "AI workspace for chats and agents.",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently --kill-others --success first \"next dev --port 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:package": "electron-builder --dir -c.mac.identity=null",
    "electron:dmg": "electron-builder --mac dmg -c.mac.identity=null",
    "electron:dist": "electron-builder"
  },
  "build": {
    "appId": "com.arcture.desktop",
    "productName": "Arcture",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "electron/arcture.icns",
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "dmg": {
      "background": "electron/dmg-background.png",
      "title": "${productName} ${version}",
      "iconSize": 96,
      "iconTextSize": 14,
      "window": {
        "width": 400,
        "height": 490
      },
      "contents": [
        {
          "x": 200,
          "y": 112
        },
        {
          "x": 200,
          "y": 379,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@polar-sh/nextjs": "^1.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "locomotive-scroll": "^5.0.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
